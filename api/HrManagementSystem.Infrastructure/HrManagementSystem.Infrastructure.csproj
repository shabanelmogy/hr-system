    <PackageReference Include="Syncfusion.Blazor.SfPdfViewer" Version="34.1.29" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.9" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.2" />
    <PackageReference Include="System.Security.Permissions" Version="10.0.9" />
