  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HrManagementSystem.Application\HrManagementSystem.Application.csproj" />
    <ProjectReference Include="..\HrManagementSystem.Domain\HrManagementSystem.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Localization\Resources\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>Localization\Resources\%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>
</Project>
