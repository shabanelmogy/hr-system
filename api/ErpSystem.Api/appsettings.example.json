{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Error",
                                     "Microsoft.AspNetCore":  "Warning",
                                     "Hangfire":  "Error"
                                 }
                },
    "ConnectionStrings":  {
                              "DefaultConnection":  "\u003cset-via-environment-or-local-config\u003e",
                              "HR":  "\u003coptional-module-specific-connection\u003e",
                              "Platform":  "\u003coptional-module-specific-connection\u003e",
                              "Accounting":  "\u003coptional-module-specific-connection\u003e",
                              "Contacts":  "\u003coptional-module-specific-connection\u003e",
                              "Redis":  "\u003cset-via-environment-or-secret-manager-when-enabled\u003e",
                              "HangfireConnection":  "\u003cset-via-environment-or-local-config\u003e"
                          },
    "Serilog":  {
                    "MinimumLevel":  {
                                         "Default":  "Information",
                                         "Override":  {
                                                          "Microsoft.AspNetCore":  "Warning",
                                                          "Hangfire":  "Information"
                                                      }
                                     },
                    "WriteTo":  [
                                    {
                                        "Name":  "Console"
                                    }
                                ],
                    "Enrich":  [
                                   "FromLogContext",
                                   "WithMachineName",
                                   "WithThreadId"
                               ],
                    "Properties":  {
                                       "ApplicationName":  "ErpSystem"
                                   }
                },
    "AllowedHosts":  "api.example.com",
    "DeploymentValidation":  {
                                "EnforceProductionReadiness":  false
                            },
    "FileSecurity":  {
                           "MalwareScanningEnabled":  false,
                           "ScannerHost":  "127.0.0.1",
                           "ScannerPort":  3310,
                           "HeaderReadLimitBytes":  65536,
                           "ScannerChunkSizeBytes":  32768,
                           "ScannerMaxResponseBytes":  4096,
                           "ScannerTimeoutSeconds":  10,
                           "MaxScanBytes":  52428800
                       },
    "DataProtection":  {
                            "ApplicationName":  "ErpSystem",
                            "KeyRingDirectory":  null,
                            "ProtectionCertificatePath":  null,
                            "ProtectionCertificatePassword":  null,
                            "SharedKeyRing":  false,
                            "PreviousProtectionCertificates":  []
                        },
    "ForwardedHeaders":  {
                              "Enabled":  false,
                              "ForwardLimit":  1,
                              "RequireHeaderSymmetry":  true,
                              "KnownProxies":  [

                                                 ],
                              "KnownNetworks":  [

                                                  ]
                          },
    "DistributedRuntime":  {
                                "Enabled":  false,
                                "ReplicaCount":  1,
                                "RedisConnectionStringName":  "Redis",
                                "CacheInstanceName":  "ErpSystem:",
                                "SignalRChannelPrefix":  "ErpSystem",
                                "ExternalRateLimitingEnabled":  false,
                                "SharedFileStorageEnabled":  false,
                                "SessionAffinityEnabled":  false
                            },
    "SwaggerSettings":  {
                            "Enabled":  false
                        },
    "OpenTelemetry":  {
                            "Enabled":  false,
                            "ServiceName":  "ErpSystem.Api",
                            "ServiceNamespace":  "ErpSystem",
                            "TraceSamplingRatio":  0.1,
                            "OtlpEndpoint":  "http://localhost:4317",
                            "OtlpProtocol":  "grpc"
                        },
    "CorsSettings":  {
                         "AllowedOrigins":  [
                                                "https://app.example.com"
                                            ]
                     },
    "JwtOptions":  {
                       "Key":  "\u003cset-via-environment-or-secret-manager\u003e",
                       "Issuer":  "HrManagementSystem",
                       "Audience":  "HrManagementSystem.Clients",
                       "ExpireInMinutes":  10,
                       "CompanySelectionExpireInMinutes":  5,
                       "RealtimeExpireInMinutes":  5
                   },
    "MailSettings":  {
                         "Enabled":  false,
                         "Mail":  "noreply@example.com",
                         "DisplayName":  "ERP System",
                         "Password":  "\u003cset-via-environment-or-local-config\u003e",
                         "Host":  "smtp.gmail.com",
                         "Port":  465
                     },
    "HangfireSettings":  {
                             "AllowedHosts":  [
                                                  "localhost",
                                                  "shabanhrms.runasp.net"
                                              ]
                         },
    "DatabaseSettings":  {
                             "ApplyMigrationsOnStartup":  false,
                             "SeedOnStartup":  false
                         },
    "Modules":  {
                    "Contacts":  {
                                     "Database":  {
                                                       "ApplyMigrationsOnStartup":  false
                                                   },
                                     "Messaging":  {
                                                       "Outbox":  {
                                                                      "BatchSize":  20,
                                                                      "MaxAttempts":  8,
                                                                      "PollInterval":  "00:00:02",
                                                                      "ProcessingTimeout":  "00:05:00",
                                                                      "BaseRetryDelay":  "00:00:05",
                                                                      "MaxRetryDelay":  "00:05:00",
                                                                      "MaxDeadRows":  0,
                                                                      "MaxDueBacklogAge":  "00:30:00"
                                                                  }
                                                   }
                                 }
                },
    "WorkforcePlanning":  {
                              "RequireStaffingRequestForNewRequisitions":  false
                          },
    "CrystalReports":  {
                           "StorageRoot":  "App_Data/CrystalReports",
