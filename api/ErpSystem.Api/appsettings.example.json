                           "MaxRenderedFileSizeBytes":  52428800,
                           "MaxRuntimeDataSizeBytes":  10485760,
                           "MaxCatalogResponseSizeBytes":  1048576,
                           "MaxDeploymentCandidates":  1000,
                           "RuntimeEnabled":  false,
                           "RuntimeBaseUrl":  "",
                           "RuntimeApiKey":  ""
                       },
    "AppSettings":  {
                        "FrontendUrl":  "https://app.example.com"
                    },
    "AttendanceConnector":  {
                                "BaseUrl":  "",
                                "TimeoutSeconds":  120,
                                "AllowedNetworks":  [

                                                    ],
                                "AllowedPorts":  [
                                                     4370
                                                 ],
                                "InternalApiKey":  "\u003cset-via-environment-or-local-config\u003e"
                            },
    "AttendanceAgent":  {
                            "PublicBaseUrl":  "https://shabanhrms.runasp.net",
                            "PollIntervalSeconds":  15
                        },
    "ExternalLogin":  {
                          "Google":  {
                                         "ClientId":  "\u003cconfigure-client-id\u003e",
                                         "ClientSecret":  "\u003cset-via-environment-or-local-config\u003e"
                                     }
                      },
    "BootstrapUsers":  {
                           "Enabled":  false,
                           "SuperAdmin":  {
                                              "UserName":  "superadmin",
                                              "Email":  "superadmin@admin.com",
                                              "Password":  "\u003cset-via-environment-or-local-config\u003e",
                                              "FirstName":  "Super",
                                              "LastName":  "Admin"
                                          },
                           "Admin":  {
                                         "UserName":  "admin",
                                         "Email":  "admin@admin.com",
                                         "Password":  "\u003cset-via-environment-or-local-config\u003e",
                                         "FirstName":  "Admin",
                                         "LastName":  "User"
                                     },
                           "Viewer":  {
                                          "UserName":  "user",
                                          "Email":  "user@user.com",
                                          "Password":  "\u003cset-via-environment-or-local-config\u003e",
                                          "FirstName":  "Normal",
                                          "LastName":  "User"
                                      }
                       }
}
