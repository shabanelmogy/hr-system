{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Error",
                                     "Microsoft.AspNetCore":  "Warning",
                                     "Hangfire":  "Error"
                                 }
                },
    "ConnectionStrings":  {
                              "DefaultConnection":  "\u003cset-via-environment-or-local-config\u003e",
                              "HR":  "\u003coptional-module-specific-connection\u003e",
                              "Platform":  "\u003coptional-module-specific-connection\u003e",
                              "Accounting":  "\u003coptional-module-specific-connection\u003e",
                              "Contacts":  "\u003coptional-module-specific-connection\u003e",
                              "HangfireConnection":  "\u003cset-via-environment-or-local-config\u003e"
                          },
    "Serilog":  {
                    "MinimumLevel":  {
                                         "Default":  "Information",
                                         "Override":  {
                                                          "Microsoft.AspNetCore":  "Warning",
                                                          "Hangfire":  "Information"
                                                      }
                                     },
                    "WriteTo":  [
                                    {
                                        "Name":  "File",
                                        "Args":  {
                                                     "path":  "Logs/hrmanagement-.json",
                                                     "rollingInterval":  "Day",
                                                     "retainedFileCountLimit":  30,
                                                     "formatter":  "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
                                                 }
                                    },
                                    {
                                        "Name":  "Console"
                                    },
                                    {
                                        "Name":  "MSSqlServer",
                                        "Args":  {
                                                     "connectionString":  "\u003cconfigure\u003e",
                                                     "tableName":  "ErrorLogs",
                                                     "schemaName":  "logging",
                                                     "autoCreateSqlTable":  true,
                                                     "ColumnOptionsSection":  {
                                                                                  "customColumns":  [
                                                                                                        {
                                                                                                            "ColumnName":  "UserId",
                                                                                                            "DataType":  "nvarchar",
                                                                                                            "DataLength":  "450"
                                                                                                        },
                                                                                                        {
                                                                                                            "ColumnName":  "UserName",
                                                                                                            "DataType":  "nvarchar",
                                                                                                            "DataLength":  "256"
                                                                                                        }
                                                                                                    ]
                                                                              },
                                                     "restrictedToMinimumLevel":  "Error"
                                                 }
                                    }
                                ],
                    "Enrich":  [
                                   "FromLogContext",
                                   "WithMachineName",
                                   "WithThreadId"
                               ],
                    "Properties":  {
                                       "ApplicationName":  "ErpSystem"
                                   }
                },
    "AllowedHosts":  "api.example.com",
    "SwaggerSettings":  {
                            "Enabled":  false
                        },
    "OpenTelemetry":  {
                            "Enabled":  false,
                            "ServiceName":  "ErpSystem.Api",
                            "ServiceNamespace":  "ErpSystem",
                            "TraceSamplingRatio":  0.1,
                            "OtlpEndpoint":  "http://localhost:4317",
                            "OtlpProtocol":  "grpc"
                        },
    "CorsSettings":  {
                         "AllowedOrigins":  [
                                                "https://app.example.com"
                                            ]
                     },
    "JwtOptions":  {
                       "Key":  "\u003cset-via-environment-or-secret-manager\u003e",
                       "Issuer":  "HrManagementSystem",
                       "Audience":  "HrManagementSystem.Clients",
                       "ExpireInMinutes":  10,
                       "CompanySelectionExpireInMinutes":  5,
                       "RealtimeExpireInMinutes":  5
                   },
    "MailSettings":  {
                         "Mail":  "noreply@example.com",
                         "DisplayName":  "ERP System",
                         "Password":  "\u003cset-via-environment-or-local-config\u003e",
                         "Host":  "smtp.gmail.com",
                         "Port":  465
                     },
    "HangfireSettings":  {
                             "AllowedHosts":  [
                                                  "localhost",
                                                  "shabanhrms.runasp.net"
                                              ]
                         },
    "DatabaseSettings":  {
                             "ApplyMigrationsOnStartup":  false,
                             "SeedOnStartup":  false
                         },
    "Modules":  {
                    "Contacts":  {
                                     "Database":  {
                                                       "ApplyMigrationsOnStartup":  false
                                                   },
                                     "Messaging":  {
                                                       "Outbox":  {
                                                                      "BatchSize":  20,
                                                                      "MaxAttempts":  8,
                                                                      "PollInterval":  "00:00:02",
                                                                      "ProcessingTimeout":  "00:05:00",
                                                                      "BaseRetryDelay":  "00:00:05",
                                                                      "MaxRetryDelay":  "00:05:00",
                                                                      "MaxDeadRows":  0,
                                                                      "MaxDueBacklogAge":  "00:30:00"
                                                                  }
                                                   }
                                 }
                },
    "WorkforcePlanning":  {
                              "RequireStaffingRequestForNewRequisitions":  false
                          },
    "CrystalReports":  {
                           "StorageRoot":  "App_Data/CrystalReports",
                           "MaxFileSizeBytes":  10485760,
                           "MaxRenderedFileSizeBytes":  52428800,
                           "MaxRuntimeDataSizeBytes":  10485760,
                           "InspectorBaseUrl":  "https://crystalreport-generator.runasp.net/",
                           "InspectorApiKey":  "\u003cset-via-environment-or-local-config\u003e"
                       },
    "AppSettings":  {
                        "FrontendUrl":  "https://app.example.com"
                    },
    "AttendanceConnector":  {
                                "BaseUrl":  "",
                                "TimeoutSeconds":  120,
                                "AllowedNetworks":  [

                                                    ],
                                "AllowedPorts":  [
                                                     4370
                                                 ],
                                "InternalApiKey":  "\u003cset-via-environment-or-local-config\u003e"
                            },
    "AttendanceAgent":  {
                            "PublicBaseUrl":  "https://shabanhrms.runasp.net",
                            "PollIntervalSeconds":  15
                        },
    "ExternalLogin":  {
                          "Google":  {
                                         "ClientId":  "\u003cconfigure-client-id\u003e",
                                         "ClientSecret":  "\u003cset-via-environment-or-local-config\u003e"
                                     }
                      },
    "BootstrapUsers":  {
                           "SuperAdmin":  {
                                              "UserName":  "superadmin",
                                              "Email":  "superadmin@admin.com",
                                              "Password":  "\u003cset-via-environment-or-local-config\u003e",
                                              "FirstName":  "Super",
                                              "LastName":  "Admin"
                                          },
                           "Admin":  {
                                         "UserName":  "admin",
                                         "Email":  "admin@admin.com",
                                         "Password":  "\u003cset-via-environment-or-local-config\u003e",
                                         "FirstName":  "Admin",
                                         "LastName":  "User"
                                     },
                           "Viewer":  {
                                          "UserName":  "user",
                                          "Email":  "user@user.com",
                                          "Password":  "\u003cset-via-environment-or-local-config\u003e",
                                          "FirstName":  "Normal",
                                          "LastName":  "User"
                                      }
                       }
}
