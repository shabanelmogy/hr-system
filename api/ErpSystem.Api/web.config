<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\ErpSystem.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
  <!-- Browser WebSocket/SSE transports carry the scoped JWT in this query only.
       Keep the larger finite envelope confined to the hub; other API limits stay inherited. -->
  <location path="hubs/company" inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxQueryString="24576" maxUrl="24576" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
