# EAS monorepo uploads contain only the mobile app and its local token dependency.
/*
!/mobile-react
!/packages
/packages/*
!/packages/tokens

# Preserve repository/app ignore boundaries, including local credentials.
**/node_modules/
**/.git/
**/.expo/
**/.kotlin/
**/.jest-cache/
**/coverage/
**/.codex-artifacts/
**/.codex-tmp/
**/bin/
**/obj/
**/.DS_Store
**/*.log
**/.tmp-*
**/*.tsbuildinfo
**/*.orig.*
**/foundation.bundle
**/*.rar
**/*.zip
**/*.7z
**/.env
**/.env.*
**/credentials.json
**/*.jks
**/*.p8
**/*.p12
**/*.key
**/*.pem
**/*.mobileprovision

# Native projects are generated by EAS; shared tokens/dist must remain included.
/mobile-react/android/
/mobile-react/ios/
/mobile-react/dist/
/mobile-react/web-build/
/mobile-react/expo-env.d.ts
/mobile-react/app-example/
