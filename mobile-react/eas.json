{
  "cli": {
    "version": ">=26.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.23.4",
      "environment": "preview",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_RELEASE_CHANNEL": "development",
        "EXPO_PUBLIC_API_CONTRACT_VERSION": "v1",
        "EXPO_PUBLIC_DEMO_LOGIN_ENABLED": "true"
      },
      "android": {
        "buildType": "apk"
      },
      "uploadSourceMaps": true
    },
    "preview": {
      "node": "22.23.4",
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_RELEASE_CHANNEL": "preview",
        "EXPO_PUBLIC_API_CONTRACT_VERSION": "v1",
        "EXPO_PUBLIC_DEMO_LOGIN_ENABLED": "true"
      },
      "android": {
        "buildType": "apk"
      },
      "uploadSourceMaps": true
    },
    "production": {
      "node": "22.23.4",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_RELEASE_CHANNEL": "production",
        "EXPO_PUBLIC_API_CONTRACT_VERSION": "v1",
        "EXPO_PUBLIC_DEMO_LOGIN_ENABLED": "false"
      },
      "uploadSourceMaps": true
    }
  }
}
