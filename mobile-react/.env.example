# Production API (works from physical devices, emulators, and web).
EXPO_PUBLIC_API_URL=https://shabanhrms.runasp.net/api/v1

# Public self-registration is disabled for the HR/account app.
# Set to true only for a business flow that intentionally supports it.
EXPO_PUBLIC_ENABLE_SELF_REGISTRATION=false

# HTTPS host shared by the web app and mobile App/Universal Links.
# Rebuild the native app after changing this value.
EXPO_PUBLIC_APP_LINK_HOST=app.example.com

# Local development alternatives:
# Android emulator: http://10.0.2.2:5293/api/v1
# Physical device: http://YOUR_LAN_IP:5293/api/v1
# iOS simulator/web: http://localhost:5293/api/v1
