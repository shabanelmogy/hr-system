{
  "name": "erp-system-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "node scripts/run-local-native.mjs android",
    "ios": "node scripts/run-local-native.mjs ios",
    "web": "expo start --web",
    "lint": "eslint app src",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:contracts": "node scripts/check-contract-matrix.mjs",
    "sync:contracts": "node scripts/sync-phase00-matrix.mjs",
    "check:dependencies": "node scripts/check-dependency-compatibility.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:native-config": "node scripts/check-native-config.mjs",
    "check:release": "node scripts/check-release-readiness.mjs",
    "check:expo": "npx expo-doctor",
    "check:export": "node scripts/check-android-export.mjs",
    "check:foundation": "node scripts/check-foundation-readiness.mjs",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage --coverageReporters=text-summary --coverageReporters=json-summary",
    "test:watch": "jest --watch",
    "check": "npm run typecheck && npm run lint && npm run check:architecture && npm run check:contracts && npm run check:i18n && npm run check:foundation && npm run check:release && npm run test:coverage"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.7.1",
    "@microsoft/signalr": "^8.0.29",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "dayjs": "^1.11.13",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-background-task": "~57.0.19",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-observe": "~57.0.23",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.19",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.3",
    "react-native-big-calendar": "^4.19.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-toast-message": "^2.4.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "1.1.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "cacheDirectory": "<rootDir>/.jest-cache",
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules/expo/node_modules"
    ],
    "moduleNameMapper": {
      "^\\./sweet/setUpJsLogger\\.fx$": "<rootDir>/scripts/jest-noop-expo-js-logger.cjs",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/*.spec.{ts,tsx}",
      "!src/**/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 20,
        "branches": 13,
        "functions": 17,
        "lines": 22
      }
    }
  },
  "private": true,
  "overrides": {
    "decode-uri-component": "file:./vendor/decode-uri-component",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
