{
  "name": "erp-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "node scripts/run-angular.mjs",
    "start": "node scripts/run-angular.mjs serve --port 4210 --ssl --ssl-cert ../web-next/certificates/localhost.pem --ssl-key ../web-next/certificates/localhost-key.pem",
    "start:local": "npm start -- --api-target=local",
    "start:host": "npm start -- --api-target=host",
    "build": "node scripts/run-angular.mjs build",
    "build:local": "npm run build -- --api-target=local",
    "build:host": "npm run build -- --api-target=host",
    "watch": "node scripts/run-angular.mjs build --watch --configuration development",
    "test": "node scripts/run-angular.mjs test --watch=false",
    "configure:api": "node scripts/configure-api.mjs",
    "test:config": "node --test scripts/configure-api.test.mjs",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "check:catalog": "node scripts/export-ui-resources.mjs --check",
    "generate:catalog": "node scripts/export-ui-resources.mjs",
    "check:architecture": "node --test scripts/architecture-rules.test.mjs scripts/dependency-rules.test.mjs && node scripts/check-architecture.mjs",
    "lint": "eslint \"src/**/*.{ts,html}\" --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"scripts/**/*.{mjs,cjs,ts}\" \"tooling/**/*.{mjs,cjs,ts}\" eslint.config.mjs",
    "check:format": "prettier --check \"src/**/*.{ts,html,scss}\" \"scripts/**/*.{mjs,cjs,ts}\" \"tooling/**/*.{mjs,cjs,ts}\" eslint.config.mjs",
    "check": "npm run check:format && npm run lint && npm run test:config && npm run check:tokens && npm run check:fonts && npm run check:catalog && npm run check:architecture && npm run type-check && npm test && npm run build",
    "configure:license": "node --env-file-if-exists=.env.local scripts/configure-license.mjs",
    "prestart": "npm run configure:license",
    "prebuild": "npm run configure:license",
    "pretest": "npm run configure:license",
    "pretype-check": "npm run configure:license && npm run configure:api",
    "prewatch": "npm run configure:license",
    "check:fonts": "node scripts/sync-fonts.mjs --check",
    "check:tokens": "node scripts/check-tokens.mjs",
    "verify:theme-browser": "node --env-file-if-exists=.env.local scripts/verify-theme-browser.mjs",
    "verify:scroll-browser": "node scripts/verify-scroll-browser.mjs",
    "verify:form-browser": "node --env-file-if-exists=.env.local scripts/verify-form-browser.mjs",
    "verify:login-browser": "node scripts/verify-login-browser.mjs",
    "verify:shell-browser": "node scripts/verify-shell-browser.mjs",
    "verify:language-browser": "node scripts/verify-language-select-browser.mjs",
    "verify:module-browser": "node scripts/verify-module-browser.mjs",
    "verify:module-context-browser": "node scripts/verify-module-context-browser.mjs",
    "verify:module-context-live": "node scripts/verify-module-context-live.mjs",
    "verify:home-browser": "node scripts/verify-home-browser.mjs",
    "verify:company-browser": "node scripts/verify-company-browser.mjs",
    "verify:fiscal-browser": "node scripts/verify-fiscal-browser.mjs",
    "verify:fiscal-live": "node scripts/verify-fiscal-live.mjs",
    "verify:api-contracts": "node --test tooling/api-contract-proof/projection.test.mjs && node tooling/api-contract-proof/verify.mjs",
    "verify:api-contracts:live": "node --test tooling/api-contract-proof/projection.test.mjs && node tooling/api-contract-proof/verify.mjs --live",
    "verify:form-close-browser": "node scripts/verify-form-close-browser.mjs",
    "verify:unsaved-browser": "node scripts/verify-unsaved-browser.mjs",
    "verify:date-browser": "node scripts/verify-date-browser.mjs",
    "verify:numeric-browser": "node scripts/verify-numeric-browser.mjs",
    "verify:boolean-browser": "node scripts/verify-boolean-browser.mjs",
    "verify:multiline-browser": "node scripts/verify-multiline-browser.mjs",
    "verify:criteria-browser": "node scripts/verify-criteria-browser.mjs",
    "verify:read-browser": "node scripts/verify-read-browser.mjs",
    "verify:country-import-browser": "node scripts/verify-country-import-browser.mjs",
    "verify:report-registration-browser": "node scripts/verify-report-registration-browser.mjs",
    "verify:report-designer-browser": "node scripts/verify-report-designer-browser.mjs",
    "verify:country-realtime-browser": "node scripts/verify-country-realtime-browser.mjs",
    "verify:country-import-reference": "node scripts/verify-country-import-reference.mjs",
    "verify:country-pilot-live": "node scripts/verify-country-pilot-live.mjs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@app/tokens": "file:../packages/tokens",
    "@microsoft/signalr": "10.0.11",
    "@primeuix/themes": "3.1.0",
    "chart.js": "4.6.1",
    "i18next": "26.5.11",
    "primeng": "22.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@vitest/eslint-plugin": "1.6.28",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^24.15.0 || ^22.22.3 || >=26.0.0"
  }
}
