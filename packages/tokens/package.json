{
  "name": "@app/tokens",
  "version": "0.2.0",
  "private": true,
  "description": "Shared design tokens (colors, typography, spacing, radius, elevation, motion) for web-next (MUI adapter, CSS variables) and mobile-react (React Native).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./css": "./dist/tokens.css",
    "./tailwind": "./dist/theme.css",
    "./json": "./dist/tokens.json"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "check": "node scripts/check-contrast.mjs && tsc --noEmit && node scripts/check-dist.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts"
}
