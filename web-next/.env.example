# Public backend URL used by the browser.
NEXT_PUBLIC_API_URL=https://api.example.com

# Backend origin used by Next.js server-side rewrites.
BACKEND_URL=https://api.example.com

# Optional developer-only backend switching. Keep disabled in production.
BACKEND_OVERRIDE_ENABLED=false
BACKEND_ALLOWED_ORIGINS=https://api.example.com
NEXT_PUBLIC_BACKEND_OVERRIDE_ENABLED=false
NEXT_PUBLIC_BACKEND_ALLOWED_ORIGINS=https://api.example.com

# Maximum non-multipart body buffered by the same-origin API proxy.
BFF_MAX_BUFFERED_BODY_BYTES=10485760

# Keep public account creation disabled for the HR application.
NEXT_PUBLIC_ENABLE_SELF_REGISTRATION=false

# Android Digital Asset Links values.
APP_LINK_ANDROID_PACKAGE=com.hrmanagementsystem.mobile
APP_LINK_ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:REPLACE_WITH_RELEASE_CERTIFICATE_SHA256

# Apple Universal Links values.
APP_LINK_IOS_BUNDLE_ID=com.hrmanagementsystem.mobile
APP_LINK_APPLE_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
