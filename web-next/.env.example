# Public backend URL used by the browser.
NEXT_PUBLIC_API_URL=https://api.example.com

# Backend origin used by Next.js server-side rewrites.
BACKEND_URL=https://api.example.com

# Public HTTPS origin of this Next.js application. When set, the browser-security
# policy publishes the modern Reporting API endpoint for CSP violation reports.
# Legacy report-uri remains same-origin even when this value is omitted.
WEB_PUBLIC_ORIGIN=https://erp.example.com

# Optional browser integrations that are reflected into the CSP allowlist by
# exact validated origin. Keep unset when the integration is unused.
# NEXT_PUBLIC_REPORT_API_URL=https://reports.example.com
# NEXT_PUBLIC_SIGNALR_HUB_URL=https://realtime.example.com/hubs/company
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id

# Optional developer-only backend switching. Keep disabled in production.
BACKEND_OVERRIDE_ENABLED=false
BACKEND_ALLOWED_ORIGINS=https://api.example.com
NEXT_PUBLIC_BACKEND_OVERRIDE_ENABLED=false
NEXT_PUBLIC_BACKEND_ALLOWED_ORIGINS=https://api.example.com

# Maximum non-multipart body buffered by the same-origin API proxy.
BFF_MAX_BUFFERED_BODY_BYTES=10485760

# Optional OpenTelemetry export for the Next.js server/BFF. Keep disabled unless
# a collector/provider is configured. Self-hosted production requires an explicit
# OTLP endpoint and sampler when this switch is true; a typical OTLP/HTTP collector
# listens on 4318. Collector credentials belong in secret-backed
# OTEL_EXPORTER_OTLP_HEADERS, never in the endpoint URL.
WEB_OTEL_ENABLED=false
# Browser diagnostics are sent only to the same-origin telemetry endpoint, which
# exports through server OpenTelemetry. Enable both telemetry switches together;
# startup validation rejects an enabled browser reporter with server export off.
# This public flag contains no secret.
NEXT_PUBLIC_WEB_TELEMETRY_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# Keep public account creation disabled for the HR application.
NEXT_PUBLIC_ENABLE_SELF_REGISTRATION=false

# Demo quick-login is useful for development/CI, but must be explicitly disabled
# for a Production release build. `npm run release:preflight` enforces this.
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=true

# Android Digital Asset Links values.
APP_LINK_ANDROID_PACKAGE=com.hrmanagementsystem.mobile
APP_LINK_ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:REPLACE_WITH_RELEASE_CERTIFICATE_SHA256

# Apple Universal Links values.
APP_LINK_IOS_BUNDLE_ID=com.hrmanagementsystem.mobile
APP_LINK_APPLE_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
