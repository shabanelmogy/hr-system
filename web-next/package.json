{
  "name": "erp-system-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem",
    "dev:http": "next dev",
    "dev:https": "next dev --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem",
    "cert:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-local-https.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "measure:build": "node scripts/measure-build.mjs",
    "generate:module": "node scripts/generate-module.mjs",
    "test:module-generator": "node scripts/generate-module.selftest.mjs",
    "type-check": "tsc --noEmit",
    "check": "npm run check:architecture && npm run check:i18n && npm run lint && npm run type-check"
  },
